@{
    Layout = null;
}
@model System.Data.DataTable
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Late Entry Dashboard</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background: #f5f7fa;
            font-family: "Segoe UI", system-ui, sans-serif;
        }

        .dashboard-container {
            max-width: 480px;
            margin: auto;
            padding: 16px;
        }

        .dashboard-header {
            text-align: center;
            margin-bottom: 20px;
        }

            .dashboard-header h4 {
                font-weight: 700;
            }

        .card {
            border-radius: 14px;
            box-shadow: 0 6px 18px rgba(0,0,0,.08);
            border: none;
        }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #495057;
        }

        .form-select {
            height: 46px;
            border-radius: 10px;
            font-size: 15px;
        }

        .btn-submit {
            height: 46px;
            border-radius: 10px;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="dashboard-container">

        <!-- Header -->
        <div class="dashboard-header">
            <h4><i class="bi bi-speedometer2"></i> Late Entry Dashboard</h4>
            <small class="text-muted">Teacher Late Control</small>
        </div>

        <!-- Card -->
        <div class="card p-4 ">

            <!-- Teacher -->
            <div class="mb-3">
                <label class="form-label">Teacher Name</label>
                <select class="form-select" name="TeacherName" id="TeacherName">
                    <option selected disabled>Select Teacher</option>

                    @foreach (System.Data.DataRow row in Model.Rows)
                    {
                        <option value='@row["TeacherName"],@row["TeacherId"]'>@row["TeacherName"]</option>
                    }

                </select>
            </div>
            <div class="mb-4">
                <label class="form-label">Period</label>
                <select class="form-select" id="Period">
                    <option selected disabled>Select Period</option>
                    <option value="1">Period 1</option>
                    <option value="2">Period 2</option>
                    <option value="3">Period 3</option>
                    <option value="4">Period 4</option>
                    <option value="5">Period 5</option>
                    <option value="6">Period 6</option>
                    <option value="7">Period 7</option>
                    <option value="8">Period 8</option>
                </select>
            </div>

            <!-- Class -->
            <div class="mb-3">
                <label class="form-label">Class(Section)</label>
                <input class="form-control" name="Class" type="text" id="Class" />
            </div>



            <!-- Late Hours -->
            <div class="mb-3">
                <label class="form-label">Late By (Min)</label>
                <input class="form-control" name="Time" type="number" id="Time" />
                
            </div>

            <!-- Period -->
            <!-- Submit -->
            <button class="btn btn-primary w-100 btn-submit mb-1" type="submit" id="btn">
                Save Late Entry
            </button>
            <a class="btn btn-warning w-100 btn-submit" href="/Home/ShowData">
                Show Data
            </a>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#btn").click(function () {
                var TeacherName = $("#TeacherName").val();
                var Class = $("#Class").val();
                var Period = $("#Period").val();
                var Time = $("#Time").val();
                //debugger
                $.ajax({
                    url: '/Home/SaveLateData',
                    type: 'POST',
                    data: {
                        TeacherName: TeacherName, Class: Class, Period: Period, Time: Time

                    },
                    success: function (msg) {
                        alert(msg);

                    },
                    error: function (msg) {
                        alert("error");
                    }
                })
            })
        })
    </script>
</body>
</html>

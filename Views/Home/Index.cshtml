@{
    Layout = null;
}

@model System.Data.DataTable

<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport"
          content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Late Manager</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background: #f5f7fa;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Segoe UI", system-ui, sans-serif;
        }

        .mobile-frame {
            width: 100%;
            max-width: 390px;
            padding: 16px;
        }

        .login-card {
            background: #ffffff;
            border-radius: 14px;
            padding: 32px 24px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.08);
        }

        .brand {
            text-align: center;
            margin-bottom: 28px;
        }

        .brand-icon {
            width: 52px;
            height: 52px;
            margin: 0 auto 10px;
            border-radius: 12px;
            background: #0d6efd;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
        }

        .brand h1 {
            font-size: 20px;
            font-weight: 700;
            margin: 0;
            color: #212529;
        }

        .brand small {
            color: #6c757d;
            font-size: 13px;
        }

        .form-label {
            font-size: 13px;
            color: #495057;
            margin-bottom: 6px;
        }

        .form-control,
        .form-select {
            height: 48px;
            font-size: 15px;
            border-radius: 10px;
            border: 1px solid #dee2e6;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 2px rgba(13,110,253,.15);
            }

        .btn-login {
            height: 48px;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
        }

        .footer {
            text-align: center;
            margin-top: 22px;
            font-size: 12px;
            color: #6c757d;
        }
    </style>
</head>

<body>

    <div class="mobile-frame">

        <div class="login-card">

            <div class="brand">
                <div class="brand-icon">
                    <i class="bi bi-clock"></i>
                </div>
                <h1>Late Manager</h1>
                @*<small>Time Management System</small>*@
            </div>
            <form method="POST">
                <div class="mb-3">
                    <label class="form-label">User</label>
                    <select class="form-select" name="userid">
                        <option selected disabled>Select user</option>
                        @if (Model != null)
                        {
                        foreach (System.Data.DataRow row in Model.Rows)
                        {
                            <option value="@row["UserId"]">@row["UserName"]/@row["UserId"]</option>
                        }
                        }
                        else
                             {
                    <option value="">Error</option>
                            }
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label">Password</label>
                    <input type="password"
                           class="form-control"
                           placeholder="Enter password" name="password" />
                </div>

                <button class="btn btn-primary w-100 btn-login">
                    Sign In
                </button>
            </form>
        </div>

        <div class="footer">
            © 2026 Late Manager · Secure Access
            
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

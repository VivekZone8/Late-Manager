@{
    Layout = null;
}
@model System.Data.DataTable

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Teacher Late Report</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background: #f2f4f7;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .container-box {
            max-width: 100%;
            padding: 10px;
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 4px 12px rgba(0,0,0,.08);
            border: none;
        }

        /* IMAGE HEADER */
        .img-header {
            text-align: center;
            margin-bottom: 6px;
        }

            .img-header h6 {
                font-size: 15px;
                font-weight: 700;
                margin: 0;
            }

            .img-header span {
                font-size: 11px;
                color: #444;
            }

        /* SHARP TABLE (MOBILE) */
        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            font-size: 11px;
            padding: 5px !important;
            white-space: nowrap;
            border: 1px solid #dee2e6;
        }

        thead {
            background: #0d6efd;
            color: #fff;
        }

        .badge-late {
            background: #dc3545;
            font-size: 10px;
            padding: 3px 6px;
            border-radius: 6px;
        }

        .btn-sm {
            font-size: 11px;
            padding: 4px 8px;
        }
    </style>
</head>

<body>

    <div class="container-box">

        <!-- SCREEN HEADER (NOT IN IMAGE) -->
        <div class="d-flex justify-content-between align-items-center mb-2">
            <strong style="font-size:14px">
                <i class="bi bi-clock-history"></i> Late Report
            </strong>

            <div class="d-flex gap-1">
                <button class="btn btn-success btn-sm" onclick="downloadImage()">
                    <i class="bi bi-download"></i>
                </button>
                <button class="btn btn-success btn-sm" onclick="shareOnWhatsApp()">
                    <i class="bi bi-whatsapp"></i>
                </button>
            </div>
        </div>

        <div class="card p-2">

            <!-- IMAGE CONTENT -->
            <div id="tableCapture" style="background:#fff; padding:8px;">

                <div class="img-header">
                    <h6>Teacher Late Report</h6>
                    <span>
                        Date :
                        @Convert.ToDateTime(Model.Rows[0]["EntryDate"]).ToString("dd-MM-yyyy")
                    </span>
                </div>

                <table class="text-center align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Period</th>
                            <th>Class</th>
                            <th>Late</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (System.Data.DataRow row in Model.Rows)
                        {
                            string period = row["Period"].ToString();
                            {
                                long lateMinutes = 0;
                                long.TryParse(row["LateTime"].ToString(), out lateMinutes);


                                if (lateMinutes >= 10)
                                {
                                    <tr style="background-color:rgba(205,0,26,0.8)" class="text-light">
                                        <td><a href="#" class="text-decoration-none text-white">@row["TeacherName"]</a></td>
                                        <td>@period[period.Length - 1]</td>
                                        <td>@row["Class"]</td>
                                        <td>
                                            <span class="badge badge-late">
                                                @row["LateTime"] min
                                            </span>
                                        </td>
                                    </tr>

                                }
                                else
                                {
                                    <tr>
                                        <td><a href="#" class="text-decoration-none text-dark">@row["TeacherName"]</a></td>
                                        <td>@period[period.Length - 1]</td>
                                        <td>@row["Class"]</td>
                                        <td>
                                            <span class="badge badge-late">
                                                @row["LateTime"] min
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                           
                        }
                    </tbody>
                </table>

            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
        const canvasOptions = {
            scale: 2.5,            // 🔥 HD QUALITY
            useCORS: true,
            backgroundColor: "#ffffff",
            logging: false
        };

        function downloadImage() {
            html2canvas(document.getElementById("tableCapture"), canvasOptions)
                .then(canvas => {
                    const link = document.createElement("a");
                    link.download = "Teacher_Late_Report_HD.png";
                    link.href = canvas.toDataURL("image/png", 1.0);
                    link.click();
                });
        }

        function shareOnWhatsApp() {
            html2canvas(document.getElementById("tableCapture"), canvasOptions)
                .then(canvas => {
                    canvas.toBlob(blob => {
                        const file = new File([blob], "Teacher_Late_Report_HD.png", {
                            type: "image/png"
                        });

                        if (navigator.canShare && navigator.canShare({ files: [file] })) {
                            navigator.share({
                                files: [file],
                                title: "Teacher Late Report",
                                text: "Teacher Late Report"
                            });
                        } else {
                            window.open("https://wa.me/?text=Teacher Late Report", "_blank");
                        }
                    }, "image/png", 1.0);
                });
        }
    </script>

</body>
</html>
